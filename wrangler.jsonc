{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mickspicks",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // No database_id needed: Cloudflare creates the D1 database on the first deploy.
  "d1_databases": [{ "binding": "DB", "database_name": "mickspicks" }],
  // Refresh scores every 10 minutes so leaderboards update on game days.
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true }
}
